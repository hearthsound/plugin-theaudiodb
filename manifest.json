{
  "manifestVersion": 1,
  "id": "app.hearthsound.theaudiodb",
  "name": "TheAudioDB metadata",
  "version": "0.1.0",
  "description": "Read artist biographies and web links from TheAudioDB, without an account or a paid API key.",
  "authors": ["Hearthsound contributors"],
  "license": "MIT OR Apache-2.0",
  "homepage": "https://github.com/hearthsound/plugin-theaudiodb",
  "api": "hearthsound:plugin@0.3.0",
  "provides": ["metadata"],
  "permissions": {
    "http": {
      "hosts": ["www.theaudiodb.com", "r2.theaudiodb.com", "$config:baseUrl"],
      "rateLimit": { "perSecond": 1, "burst": 1 }
    }
  },
  "config": {
    "server": {
      "schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "properties": {
          "apiKey": {
            "type": "string",
            "title": "TheAudioDB API key",
            "description": "API key sent in the URL path. The public test key 123 works for evaluation; a premium key raises the rate limit and unlocks the full result set.",
            "default": "123"
          },
          "baseUrl": {
            "type": "string",
            "format": "uri",
            "title": "TheAudioDB API base URL",
            "description": "Base URL of the v1 JSON API. Point it at a mirror or a test double to keep traffic off theaudiodb.com.",
            "default": "https://www.theaudiodb.com/api/v1/json/"
          }
        }
      },
      "uiSchema": {
        "type": "VerticalLayout",
        "elements": [
          { "type": "Control", "scope": "#/properties/apiKey" },
          { "type": "Control", "scope": "#/properties/baseUrl" }
        ]
      }
    },
    "user": null
  },
  "resources": { "memoryMb": 64, "callTimeoutMs": 15000, "maxInstances": 2 }
}
